rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownsDoc() { return signedIn() && resource.data.user_id == request.auth.uid; }

    // ── Profile ────────────────────────────────────────────────────────────
    // Game state (XP, level, streaks, hearts, Pro tier, boss stamps, cosmetics
    // owned, role) is written only by the server (Admin SDK bypasses rules).
    // The client may create a fresh profile and edit the cosmetic/personal fields.
    match /users/{userId} {
      // A frame or title can be equipped only if the server granted it.
      function equippedIsOwned(field) {
        return !(field in request.resource.data)
          || request.resource.data[field] == null
          || request.resource.data[field] in resource.data.get('cosmetics', {});
      }

      allow read: if signedIn() && request.auth.uid == userId;

      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
             'id', 'username', 'display_name', 'avatar_url', 'bio', 'country',
             'learning_goal', 'daily_goal_minutes', 'level', 'total_xp',
             'current_streak', 'longest_streak', 'hearts', 'hearts_updated_at',
             'role', 'created_at', 'updated_at'])
        && request.resource.data.total_xp == 0
        && request.resource.data.level == 1
        && request.resource.data.current_streak == 0
        && request.resource.data.longest_streak == 0
        && request.resource.data.hearts == 5
        && request.resource.data.role == 'user';

      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'display_name', 'bio', 'country', 'learning_goal', 'daily_goal_minutes',
             'avatar_url', 'profile_bg', 'equipped_frame', 'equipped_title', 'updated_at'])
        && equippedIsOwned('equipped_frame')
        && equippedIsOwned('equipped_title');
    }

    // ── Server-written records: the owner may read, nobody writes from the client ──
    match /user_lesson_progress/{docId} { allow read: if ownsDoc(); }
    match /daily_activity/{docId}       { allow read: if ownsDoc(); }
    match /user_achievements/{docId}    { allow read: if ownsDoc(); }
    match /user_provinces/{docId}       { allow read: if ownsDoc(); }
    match /chat_messages/{docId}        { allow read: if ownsDoc(); }
    match /xp_transactions/{docId}      { allow read: if ownsDoc(); }

    // Everything else (including the legacy `profiles` collection) is denied by default.
  }
}
